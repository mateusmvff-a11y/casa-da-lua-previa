[
 {"bloco":"Suítes - bloco 1","item":"retire os textos da parte de baixo (\"escolha a suíte pelo jeito de viajar\" e \"capacidade · acesso · vista · bem-estar\", a nota inteira do hero)","expr":"(()=>{const p=document.getElementById('page-suites');const t=p.textContent.toLowerCase();return !p.querySelector('.suites-hero-note')&&!t.includes('jeito de viajar')&&!t.includes('capacidade · acesso · vista · bem-estar')})()"},
 {"bloco":"Suítes - bloco 2","item":"o botão \"Consultar datas\" de \"Sua escolha te acompanha\" aponta para a página de consultar datas, sem âncora","expr":"(()=>{const b=document.querySelector('#page-suites .suites-steps-cta .btn');return !!b&&b.textContent.trim()==='Consultar datas'&&b.dataset.pageTarget==='reservar'&&!b.dataset.anchor&&!b.dataset.scrollTo&&!b.closest('a')})()"},
 {"bloco":"Suítes - bloco 3","item":"são 8 cartões de categoria, com os ids do V16 e nenhum \"featured\"","expr":"(()=>{const c=[...document.querySelectorAll('#page-suites .suite-card')];return c.map(x=>x.dataset.suiteId).join()==='standard,luxo,luxo-superior,premium,premium-hidro,premium-ofuro,master,presidencial'&&!document.querySelector('#page-suites .suite-card.featured')})()"},
 {"bloco":"Suítes - bloco 3","item":"mesma altura em todos os 8 cartões","expr":"(()=>{const h=[...document.querySelectorAll('#page-suites .suite-card')].map(c=>c.getBoundingClientRect().height);return Math.max(...h)-Math.min(...h)<=1})()"},
 {"bloco":"Suítes - bloco 3","item":"foto de mesma altura em todos os cartões","expr":"(()=>{const h=[...document.querySelectorAll('#page-suites .suite-card-media')].map(c=>c.getBoundingClientRect().height);return Math.max(...h)-Math.min(...h)<=1})()"},
 {"bloco":"Suítes - bloco 3","item":"bloco de texto com as mesmas margens: unidades·m², título e descrição começam na mesma distância do topo do cartão em todos","expr":"(()=>{const s=['.suite-card-top','h3','p'];return s.every(q=>{const v=[...document.querySelectorAll('#page-suites .suite-card')].map(c=>c.querySelector(q).getBoundingClientRect().top-c.getBoundingClientRect().top);return Math.max(...v)-Math.min(...v)<=1})})()"},
 {"bloco":"Suítes - bloco 3","item":"descrições com a mesma altura (mínimo igual)","expr":"(()=>{const v=[...document.querySelectorAll('#page-suites .suite-card p')].map(p=>p.getBoundingClientRect().height);return Math.max(...v)-Math.min(...v)<=1})()"},
 {"bloco":"Suítes - bloco 3","item":"tags na mesma linha base em todos os cartões","expr":"(()=>{const v=[...document.querySelectorAll('#page-suites .suite-card')].map(c=>c.querySelector('.tag-row').getBoundingClientRect().top-c.getBoundingClientRect().top);return Math.max(...v)-Math.min(...v)<=1})()"},
 {"bloco":"Suítes - bloco 3","item":"\"comparar\" e \"Ver detalhes\" alinhados na mesma linha em todos os cartões (e entre si)","expr":"(()=>{const cs=[...document.querySelectorAll('#page-suites .suite-card')];const rel=(c,q)=>{const r=c.querySelector(q).getBoundingClientRect();return (r.top+r.bottom)/2-c.getBoundingClientRect().top};const a=cs.map(c=>rel(c,'.suite-actions label')),b=cs.map(c=>rel(c,'.suite-detail-btn'));return Math.max(...a,...b)-Math.min(...a,...b)<=3})()"},
 {"bloco":"Suítes - bloco 3","item":"fonte do corpo do texto dos cartões é a Forma DJR (descrição, chips, unidades·m², comparar, Ver detalhes); sem Inter","expr":"(()=>{const els=['.suite-card-top span','p','.tag-row span','.suite-actions label','.suite-detail-btn'];return els.every(q=>[...document.querySelectorAll('#page-suites .suite-card '+q)].every(e=>{const f=getComputedStyle(e).fontFamily.toLowerCase();return f.includes('forma-djr-display')&&!f.includes('inter')}))})()"},
 {"bloco":"Suítes - bloco 3","item":"filtros e contador continuam funcionando (Até 2 hóspedes mostra 3 cartões)","expr":"(()=>{document.querySelector('#page-suites .suite-filter[data-suite-filter=\"2 hóspedes\"]').click();const n=document.querySelectorAll('#page-suites .suite-card:not(.hidden-by-filter)').length;const c=document.getElementById('suiteCount').textContent;document.querySelector('#page-suites .suite-filter[data-suite-filter=\"all\"]').click();return n===3&&c==='3'&&document.querySelectorAll('#page-suites .suite-card:not(.hidden-by-filter)').length===8})()"},
 {"bloco":"Suítes - bloco 4","item":"EXCLUA a seção escura \"Compare o que importa\" (HTML e CSS)","expr":"(()=>{const p=document.getElementById('page-suites');const css=[...document.styleSheets].flatMap(s=>{try{return [...s.cssRules].map(r=>r.cssText)}catch(e){return []}}).join('');return !p.querySelector('.suites-compare, .suites-criteria, #openCompareFromSection')&&!p.textContent.includes('Compare o que importa')&&!p.textContent.includes('Critérios de decisão')&&!css.includes('suites-compare')&&!css.includes('suites-criteria')})()"},
 {"bloco":"Suítes - bloco 4","item":"o comparador continua pela barra flutuante #compareDock (2 marcados habilitam Comparar; sem #openCompareFromSection não há erro)","expr":"(()=>{const cs=[...document.querySelectorAll('#page-suites .compare-check')];cs[0].click();cs[1].click();const ok=getComputedStyle(document.getElementById('compareDock')).display!=='none'&&document.getElementById('compareCount').textContent==='2'&&!document.getElementById('openCompare').disabled;cs[0].click();cs[1].click();return ok&&getComputedStyle(document.getElementById('compareDock')).display==='none'})()"},
 {"bloco":"Suítes - geral","item":"retire qualquer subtexto ao lado de títulos grandes de seção (só o contador funcional \"N categorias visíveis\" pode ficar)","expr":"(()=>{const s=[...document.querySelectorAll('#page-suites .section-head p, #page-suites .section-head .small')];return s.length===1&&!!s[0].querySelector('#suiteCount')})()"},
 {"bloco":"Suítes - bloco 2","item":"clicando em \"Consultar datas\" abre a página Reservar no topo absoluto (scrollY≈0)","expr":"(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));window.scrollTo(0,0);document.querySelector('#page-suites .suites-steps').scrollIntoView({block:'center'});await w(300);const y0=scrollY;const b=document.querySelector('#page-suites .suites-steps-cta .btn');b.click();await w(3000);return y0>300&&CDL.currentPage==='reservar'&&scrollY<=2&&document.getElementById('page-reservar').classList.contains('active')})()"}
]
